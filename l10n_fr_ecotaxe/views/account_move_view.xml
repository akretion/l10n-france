<odoo>
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">l10n_fr_ecotaxe.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']"
                position="after"
            >
                <field name="subtotal_ecotaxe" optional="show" />
                <field name="ecotaxe_amount_unit" optional="hide" />
                <field name="ecotaxe_line_ids" optional="show" />
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/form/sheet/field[@name='name']"
                position="after"
            >
                <field name="ecotaxe_line_ids">
                    <tree editable="bottom">
                        <field name="ecotaxe_classification_id"/>
                        <field name="force_ecotaxe_unit"/>
                        <field name="ecotaxe_amount_unit"/>
                        <field name="ecotaxe_amount_total"/>
                    </tree>
                </field>
                <field name="subtotal_ecotaxe"/>
                <field name="ecotaxe_amount_unit"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="after">
                    <field name="amount_ecotaxe" class="oe_subtotal_footer_separator" />
            </xpath>
        </field>
    </record>
</odoo>
