<odoo>
    <record id="view_account_payment_tree_payment_order" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field
            name="inherit_id"
            ref="account_payment_order.view_account_payment_tree_payment_order"
        />
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field name="rejection_date" optional="hide" />
                <field name="rejection_reason" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field
            name="inherit_id"
            ref="account_payment_order.view_account_payment_form"
        />
        <field name="arch" type="xml">
            <field name="payment_reference" position="after">
                <field
                    name="rejection_date"
                    attrs="{'invisible': [('rejection_date', '=', False)]}"
                />
                <field
                    name="rejection_reason"
                    attrs="{'invisible': [('rejection_reason', '=', False)]}"
                />
            </field>
        </field>
    </record>

    <record id="view_account_payment_search" model="ir.ui.view">
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search" />
        <field name="arch" type="xml">
            <filter name="date" position="before">
                <filter
                    name="rejected"
                    domain="[('rejection_date', '!=', False)]"
                    string="Rejected"
                />
                <separator />
            </filter>
        </field>
    </record>
</odoo>
