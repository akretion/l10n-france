<odoo>
    <record id="account_payment_order_rejection_import_form" model="ir.ui.view">
        <field name="model">account.payment.order.rejection.import</field>
        <field name="arch" type="xml">
            <form>
                <field name="state" invisible="1" />
                <group name="file_import" states="import">
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="attachment_ids" widget="many2many_binary" />
                </group>
                <group string="Rejection Lines" states="check">
                    <field name="line_ids" colspan="2" nolabel="1">
                        <tree editable="bottom" decoration-danger="not payment_id">
                            <field name="company_id" invisible="1" />
                            <field name="payment_type" optional="hide" />
                            <field name="payment_method_code" optional="hide" />
                            <field name="company_name" optional="hide" />
                            <field name="company_partner_bank_id" optional="hide" />
                            <field name="journal_id" optional="show" />
                            <field name="rejection_date" optional="show" />
                            <field name="payment_date" optional="hide" />
                            <field name="partner_bank_id" optional="hide" />
                            <field name="partner_id" />
                            <field name="partner_name" />
                            <field name="label" optional="show" />
                            <field name="reason" optional="show" />
                            <field name="rejection_amount" />
                            <field name="currency_id" invisible="1" />
                            <field name="payment_id" />
                            <field name="payment_match" optional="show" />
                            <field name="payment_order_id" optional="hide" />
                        </tree>
                    </field>
                </group>
                <footer>
                    <button
                        name="import_files"
                        type="object"
                        string="Import Files"
                        states="import"
                        class="btn-primary"
                    />
                    <button
                        name="validate"
                        type="object"
                        string="Validate"
                        states="check"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="account_payment_order_rejection_import_action"
        model="ir.actions.act_window"
    >
        <field name="res_model">account.payment.order.rejection.import</field>
        <field name="name">Import Rejection Files</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="account_payment_order_rejection_import_menu"
        action="account_payment_order_rejection_import_action"
        parent="account.menu_finance_entries_actions"
        sequence="100"
    />
</odoo>
